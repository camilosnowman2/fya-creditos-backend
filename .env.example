# Copia este archivo como ".env" (queda ignorado por git) junto al
# docker-compose.yml y completa tus propios valores. NUNCA subas el ".env"
# real al repositorio.

POSTGRES_PASSWORD=fya_dev_password

# SMTP genérico: Gmail con contraseña de aplicación, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-contraseña-de-aplicacion
SMTP_FROM_ADDRESS=tu-correo@gmail.com
SMTP_NOTIFICATION_RECIPIENT=fyasocialcapital@gmail.com

# Genera esto con: python3 tools/generate_password_hash.py
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=

# Clave simétrica para firmar los JWT, minimo 32 caracteres.
JWT_SECRET=cambia-esto-por-una-clave-secreta-larga-y-aleatoria

# Origen del frontend para CORS (ej: http://localhost:8100 en dev con Ionic)
FRONTEND_ORIGIN=http://localhost:8100
